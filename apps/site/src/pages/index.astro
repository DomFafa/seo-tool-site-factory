---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../blocks/BlockRenderer.astro';
import { loadSelectedSite, loadHomeContent, loadFaqContent } from '@factory/site-core';

const ctx = await loadSelectedSite();
const locale = ctx.siteConfig.defaultLocale;
const home = await loadHomeContent(ctx, locale);
const faq = await loadFaqContent(ctx, locale);
---
<BaseLayout ctx={ctx} locale={locale} page={home} pageType="home">
  <BlockRenderer ctx={ctx} locale={locale} home={home} faq={faq} />
</BaseLayout>

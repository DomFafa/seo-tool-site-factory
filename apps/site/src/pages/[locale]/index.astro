---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../blocks/BlockRenderer.astro';
import { loadSelectedSite, loadHomeContent, loadFaqContent, getEnabledNonDefaultLocales } from '@factory/site-core';

export async function getStaticPaths() {
  const ctx = await loadSelectedSite();
  return getEnabledNonDefaultLocales(ctx).map((locale) => ({ params: { locale }, props: { locale } }));
}

const ctx = await loadSelectedSite();
const { locale } = Astro.props;
const home = await loadHomeContent(ctx, locale);
const faq = await loadFaqContent(ctx, locale);
---
<BaseLayout ctx={ctx} locale={locale} page={home} pageType="home">
  <BlockRenderer ctx={ctx} locale={locale} home={home} faq={faq} />
</BaseLayout>

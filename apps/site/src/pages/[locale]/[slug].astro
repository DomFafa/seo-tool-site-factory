---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { loadSelectedSite, getEnabledNonDefaultLocales, listPageContent, loadPageContent } from '@factory/site-core';

export async function getStaticPaths() {
  const ctx = await loadSelectedSite();
  const paths = [];
  for (const locale of getEnabledNonDefaultLocales(ctx)) {
    const pages = await listPageContent(ctx, locale);
    for (const page of pages) {
      paths.push({ params: { locale, slug: page.frontmatter.slug }, props: { locale, slug: page.frontmatter.slug } });
    }
  }
  return paths;
}

const ctx = await loadSelectedSite();
const { locale, slug } = Astro.props;
const page = await loadPageContent(ctx, locale, slug);
---
<BaseLayout ctx={ctx} locale={locale} page={page} pageType="page" slug={slug}>
  <section class="hero">
    <div class="container">
      <h1>{page.frontmatter.title}</h1>
      <p>{page.frontmatter.description}</p>
    </div>
  </section>
  <div class="container">
    <article class="content-card" set:html={page.html}></article>
    <AdSlot ctx={ctx} placement="inArticle" />
  </div>
</BaseLayout>

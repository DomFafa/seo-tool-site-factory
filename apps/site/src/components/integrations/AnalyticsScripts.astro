---
import type { SiteContext } from '@factory/site-core';
import { getAnalyticsRenderModel } from '@factory/integrations';
interface Props { ctx: SiteContext; }
const model = getAnalyticsRenderModel(Astro.props.ctx);
---
{model.ga4?.enabled && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${model.ga4.measurementId}`}></script>
    <script is:inline define:vars={{ measurementId: model.ga4.measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', measurementId);
      window.__factoryTrack = function(eventName, params) {
        try { gtag('event', eventName, params || {}); } catch (_) {}
      };
    </script>
  </>
)}
{model.clarity?.enabled && (
  <script is:inline define:vars={{ projectId: model.clarity.projectId }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", projectId);
  </script>
)}

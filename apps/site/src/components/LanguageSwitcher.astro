---
import type { SiteContext } from '@factory/site-core';
import { getLocaleHomeUrl } from '@factory/seo';
interface Props { ctx: SiteContext; locale: string; }
const { ctx, locale } = Astro.props;
const locales = Object.entries(ctx.siteConfig.locales).filter(([, cfg]) => cfg.enabled);
---
<div class="language-switcher" aria-label="Language selector">
  {locales.map(([code]) => (
    <a href={getLocaleHomeUrl(ctx, code)} aria-current={code === locale ? 'true' : undefined}>{code.toUpperCase()}</a>
  ))}
</div>

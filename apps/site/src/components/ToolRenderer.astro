---
import SelectedToolIsland from '../.generated/SelectedToolIsland.tsx';
import { selectedToolMeta } from '../.generated/selected-tool-meta';
import type { SiteContext } from '@factory/site-core';

interface Props { ctx: SiteContext; locale: string; }
const { ctx, locale } = Astro.props;
const toolId = ctx.siteConfig.primaryTool;
const toolConfig = ctx.toolConfig;
---
<section class="tool-shell" aria-label="Interactive tool">
  {selectedToolMeta.toolId === toolId && selectedToolMeta.renderer === 'react' && (
    <SelectedToolIsland client:load locale={locale} config={toolConfig} />
  )}
  {selectedToolMeta.toolId !== toolId && (
    <div class="error">Generated tool renderer is for <strong>{selectedToolMeta.toolId}</strong>, but this page needs <strong>{toolId}</strong>.</div>
  )}
</section>

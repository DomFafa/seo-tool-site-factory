---
import '../styles/global.css';
import '../styles/ui-differentiation.css';
import VerificationMeta from '../components/integrations/VerificationMeta.astro';
import AnalyticsScripts from '../components/integrations/AnalyticsScripts.astro';
import AdProviderScripts from '../components/integrations/AdProviderScripts.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import type { SiteContext, ContentDocument } from '@factory/site-core';
import { buildPageSeo, getLocaleHomePath } from '@factory/seo';

interface Props {
  ctx: SiteContext;
  locale: string;
  page: ContentDocument;
  pageType: 'home' | 'guide';
  slug?: string;
}

const { ctx, locale, page, pageType, slug } = Astro.props;
const seo = buildPageSeo(ctx, { locale, page, pageType, slug });
const theme = ctx.themeConfig;
const primary = theme?.colors?.primary ?? '#2563eb';
const bg = theme?.colors?.background ?? '#f7f8fb';
const surface = theme?.colors?.surface ?? '#ffffff';
const accent = theme?.colors?.accent ?? primary;
const radius = theme?.radius ?? '18px';
const recipe = ctx.layoutConfig.recipe;
const navVariant = ctx.layoutConfig.chrome.navVariant;
const density = theme?.density ?? 'comfortable';
const surfaceStyle = theme?.surface ?? 'cards';
const chromeCopy = locale === 'es'
  ? {
      home: 'Inicio',
      navLabel: 'Navegación principal',
      footer: 'Herramienta ligera para convertir imágenes a PNG en el navegador.'
    }
  : {
      home: 'Home',
      navLabel: 'Main navigation',
      footer: 'Built as a lightweight tool site.'
    };
const homePath = getLocaleHomePath(ctx, locale);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex,nofollow" />}
    {seo.alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:type" content={pageType === 'guide' ? 'article' : 'website'} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline define:vars={{ primary, bg, surface, accent, radius }}>
      :root {
        --factory-primary: var(--primary);
        --factory-bg: var(--bg);
        --factory-surface: var(--surface);
        --factory-accent: var(--accent);
        --factory-radius: var(--radius);
      }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />
    <VerificationMeta ctx={ctx} />
    <AnalyticsScripts ctx={ctx} />
    <AdProviderScripts ctx={ctx} />
  </head>
  <body class={`recipe-${recipe} nav-${navVariant} density-${density} surface-${surfaceStyle}`}>
    <header class={`site-header site-header--${navVariant}`}>
      <div class="container site-header-inner">
        <a class="brand" href={homePath}>
          <span class="brand-mark">{ctx.siteConfig.brandName.slice(0, 1).toUpperCase()}</span>
          <span>{ctx.siteConfig.brandName}</span>
        </a>
        <nav class="nav nav--desktop" aria-label={chromeCopy.navLabel}>
          <a href={homePath}>{chromeCopy.home}</a>
          {ctx.layoutConfig.chrome.headerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <LanguageSwitcher ctx={ctx} locale={locale} />
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Open navigation">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <nav class="mobile-menu__panel" aria-label={chromeCopy.navLabel}>
            <a href={homePath}>{chromeCopy.home}</a>
            {ctx.layoutConfig.chrome.headerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            <LanguageSwitcher ctx={ctx} locale={locale} />
          </nav>
        </details>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class={`footer footer--${ctx.layoutConfig.chrome.footerVariant}`}>
      <div class="container">
        <p>© {new Date().getFullYear()} {ctx.siteConfig.brandName}. {chromeCopy.footer}</p>
        {ctx.layoutConfig.chrome.footerLinks.length > 0 && (
          <nav class="footer-links" aria-label="Footer navigation">
            {ctx.layoutConfig.chrome.footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        )}
      </div>
    </footer>
  </body>
</html>

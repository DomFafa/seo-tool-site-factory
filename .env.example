# Per-site Cloudflare account profiles.
# Copy to .env.local and fill values locally. Do not commit .env.local.
# GitHub Actions should not deploy; deployment is local-only.

CF_ACCOUNT_TYPING_SPEED_TEST=
CF_TOKEN_TYPING_SPEED_TEST=

CF_ACCOUNT_CONVERTIR_IMAGEN_A_PNG=
CF_TOKEN_CONVERTIR_IMAGEN_A_PNG=

CF_ACCOUNT_CURSIVE_GENERATOR=
CF_TOKEN_CURSIVE_GENERATOR=

CF_ACCOUNT_CURSED_TEXT_GENERATOR=
CF_TOKEN_CURSED_TEXT_GENERATOR=

CF_ACCOUNT_ANAGRAM_SOLVER=
CF_TOKEN_ANAGRAM_SOLVER=

CF_ACCOUNT_CURSIVE_ALPHABET=
CF_TOKEN_CURSIVE_ALPHABET=

CF_ACCOUNT_TYPING_PRACTICE=
CF_TOKEN_TYPING_PRACTICE=

CF_ACCOUNT_TYPING_PRACTICE_PARAGRAPH=
CF_TOKEN_TYPING_PRACTICE_PARAGRAPH=

CF_ACCOUNT_TYPING_TEST_ONLINE=
CF_TOKEN_TYPING_TEST_ONLINE=

CF_ACCOUNT_CORRECTEUR_ORTHOGRAPHE=
CF_TOKEN_CORRECTEUR_ORTHOGRAPHE=

CF_ACCOUNT_CONVERT_IMAGE_TO_PNG=
CF_TOKEN_CONVERT_IMAGE_TO_PNG=

# Optional. Defaults to https://api.cloudflare.com/client/v4
CLOUDFLARE_API_BASE=

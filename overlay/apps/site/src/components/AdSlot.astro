---
import type { SiteContext } from '@factory/site-core';
import { getAdSlotRenderModel } from '@factory/integrations';

interface Props { ctx: SiteContext; placement: string; }
const { ctx, placement } = Astro.props;
const model = getAdSlotRenderModel(ctx, placement);
---
{model.kind === 'disabled' && null}
{model.kind === 'placeholder' && <div class="ad-slot" data-placement={placement}>Ad slot: {placement}</div>}
{model.kind === 'adsense' && (
  <div class="ad-slot" data-placement={placement}>
    <ins
      class="adsbygoogle"
      style="display:block; width:100%; min-height:90px;"
      data-ad-client={model.client}
      data-ad-slot={model.slot}
      data-ad-format={model.format}
      data-full-width-responsive="true"></ins>
    <script is:inline>{`(window.adsbygoogle = window.adsbygoogle || []).push({});`}</script>
  </div>
)}
{model.kind === 'raw-html' && <div class="ad-slot" data-placement={placement} set:html={model.html} />}

---
import type { SiteContext } from '@factory/site-core';
import { getAdProviderScriptModel } from '@factory/integrations';
interface Props { ctx: SiteContext; }
const model = getAdProviderScriptModel(Astro.props.ctx);
---
{model.adsense?.enabled && (
  <script
    async
    crossorigin="anonymous"
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${model.adsense.publisherId}`}>
  </script>
)}

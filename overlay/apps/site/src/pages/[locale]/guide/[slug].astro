---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { loadSelectedSite, getEnabledNonDefaultLocales, listGuideContent, loadGuideContent } from '@factory/site-core';

export async function getStaticPaths() {
  const ctx = await loadSelectedSite();
  const paths = [];
  for (const locale of getEnabledNonDefaultLocales(ctx)) {
    const guides = await listGuideContent(ctx, locale);
    for (const guide of guides) {
      paths.push({ params: { locale, slug: guide.frontmatter.slug }, props: { locale, slug: guide.frontmatter.slug } });
    }
  }
  return paths;
}

const ctx = await loadSelectedSite();
const { locale, slug } = Astro.props;
const guide = await loadGuideContent(ctx, locale, slug);
---
<BaseLayout ctx={ctx} locale={locale} page={guide} pageType="guide" slug={slug}>
  <section class="hero">
    <div class="container">
      <h1>{guide.frontmatter.title}</h1>
      <p>{guide.frontmatter.description}</p>
    </div>
  </section>
  <div class="container">
    <article class="content-card" set:html={guide.html}></article>
    <AdSlot ctx={ctx} placement="inArticle" />
  </div>
</BaseLayout>
